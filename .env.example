# ---- Runtime ----
NODE_ENV=production
HOST=127.0.0.1
PORT=3001

# ---- MariaDB ----
DB_HOST=your.db.host
DB_PORT=3306
DB_USER=readonly_user
DB_PASSWORD=changeme
DB_NAME=your_database
DB_SSL=false
DB_POOL_SIZE=3

# ---- Auth (bootstrap admin: seeds SQLite on first start if users table is empty) ----
AUTH_USERNAME=admin
AUTH_PASSWORD=change-this-strong-password
JWT_SECRET=replace-with-32-char-random-string
JWT_TTL_HOURS=8

# ---- Office IP allowlist for role=staff (admins bypass). Empty disables. ----
OFFICE_IP_ALLOWLIST=

# ---- SQLite users database location ----
USERS_DB_PATH=data/app.db

# ---- Lookup cache ----
LOOKUP_CACHE_TTL_SECONDS=45
LOOKUP_CACHE_MAX=500
